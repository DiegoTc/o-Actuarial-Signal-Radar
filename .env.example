# Phase 1–3.5 requires no credentials. Docker Compose passes only named Phase 4 settings.
# Copy to .env locally; never commit actual credentials. Scripts do not auto-load .env outside Compose.
INVESTIGATION_PROVIDER=mock
INVESTIGATION_LANGUAGE=en
INVESTIGATION_TIMEOUT_SECONDS=60
INVESTIGATION_MAX_TOKENS=2500

# Only required for provider=amd_vllm. Include /v1. No model is assumed.
AMD_VLLM_BASE_URL=
AMD_VLLM_MODEL=
AMD_VLLM_API_KEY=

# ACT III shared model API (free hackathon allowance; no GPU droplet required).
# Set INVESTIGATION_PROVIDER=amd_token_factory for the live Evolus workflow.
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_TOKEN_FACTORY_MODEL=DeepSeek-V4-Flash
AMD_TOKEN_FACTORY_API_KEY=

# Only required for explicit Evolus uploads/workflow execution.
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_APPLICATION_ID=
# Optional aliases for EVOLUS_BASE_URL / EVOLUS_APPLICATION_ID (leave blank when using canonical names).
EVOLUS_API_URL=
EVOLUS_WORKSPACE_ID=
EVOLUS_API_KEY=
EVOLUS_WORKFLOW_ID=
EVOLUS_LIBRARY_ID=
# JSON Pointer to your workflow's result object in a Completed execution.
# Inspect the workspace response/reference; no undocumented default is assumed.
EVOLUS_RESULT_POINTER=
EVOLUS_POLL_INTERVAL_SECONDS=2
EVOLUS_MAXIMUM_POLLS=30
