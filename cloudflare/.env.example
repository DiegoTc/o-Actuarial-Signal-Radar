# Local transport only. No provider keys belong in frontend/build variables.
LOCAL_EXPERIMENT=1
API_ORIGIN=http://127.0.0.1:3000
# Optional dedicated live compatibility backend uses http://127.0.0.1:8002.
# Backend only, future hosting secret store / Wrangler secrets if Python is ported:
# EVOLUS_API_KEY=<secret>
# EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
# EVOLUS_APPLICATION_ID=<workspace ID>
# EVOLUS_WORKFLOW_ID=<workflow ID>
# EVOLUS_LIBRARY_ID=<library ID>
# EVOLUS_RESULT_POINTER=/output
# INVESTIGATION_PROVIDER=amd_token_factory
# AMD_TOKEN_FACTORY_MODEL=DeepSeek-V4-Flash
# AMD_TOKEN_FACTORY_API_KEY=<only if directly calling AMD; Evolus stores its own credential>
