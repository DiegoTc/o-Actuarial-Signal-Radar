{
  "name": "actuarial-radar-cloudflare-experiment",
  "private": true,
  "scripts": {
    "build": "node prepare.mjs && node build.mjs",
    "dev": "wrangler dev --config ../.local/cloudflare/frontend/wrangler.jsonc --ip 127.0.0.1 --port 8787 --local",
    "python:dev": "wrangler dev --config python/wrangler.jsonc --ip 127.0.0.1 --port 8788 --local",
    "test": "node --test tests/*.test.mjs",
    "stage": "node prepare.mjs",
    "build:production": "node prepare.mjs --production && node build.mjs",
    "deploy:production": "node deploy-production.mjs"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
